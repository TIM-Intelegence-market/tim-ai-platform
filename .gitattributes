# Canonical repository line-ending policy.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.md text eol=lf
*.mmd text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.txt text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.sqlite binary
*.sqlite3 binary
*.db binary

# Real federalreserve.gov pages stay byte for byte as downloaded (CRLF); provenance.json holds their SHA-256.
tests/fixtures/research_lab/fomc_statements_2019_2020/*.html -text
