{
  "version": 1,
  "enabled": false,
  "dry_run": true,
  "base_branch": "platform-main",
  "worker_logins": [],
  "head_branch_regex": "^claude/issue-[0-9]+-[a-z0-9-]+$",
  "required_checks": [
    {
      "name": "test",
      "workflow_path": ".github/workflows/ci.yml",
      "event": "pull_request"
    },
    {
      "name": "TIM full suite",
      "workflow_path": ".github/workflows/tim-full-suite.yml",
      "event": "pull_request"
    }
  ],
  "check_app_slugs": [
    "github-actions"
  ],
  "allowed_conclusions": [
    "success"
  ],
  "merge_method": "squash",
  "max_merges_per_run": 1,
  "required_statuses": [
    {
      "context": "pr-gate/head",
      "creator": "github-actions[bot]",
      "workflow_path": ".github/workflows/pr-gate.yml",
      "event": "pull_request_target"
    }
  ],
  "require_app_token": true,
  "require_rulesets": true,
  "merger_app_id": 0,
  "check_integration_id": 15368,
  "required_rulesets": [
    {
      "name": "platform-main merge conditions",
      "rules": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_status_checks"
      ],
      "bypass": "none"
    },
    {
      "name": "platform-main restrict updates",
      "rules": [
        "update"
      ],
      "bypass": "merger_only"
    }
  ],
  "expected_pull_request_parameters": {
    "required_approving_review_count": 0,
    "dismiss_stale_reviews_on_push": false,
    "required_reviewers": [],
    "require_code_owner_review": false,
    "dismissal_restriction": {"enabled": false, "allowed_actors": []},
    "require_last_push_approval": false,
    "required_review_thread_resolution": false,
    "require_extra_approval_for_unattributed_changes": true,
    "allowed_merge_methods": ["merge", "squash", "rebase"]
  },
  "expected_status_checks_parameters": {
    "strict_required_status_checks_policy": true,
    "do_not_enforce_on_create": false
  }
}
