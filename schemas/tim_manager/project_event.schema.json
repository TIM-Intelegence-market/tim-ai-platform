{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tim://schemas/project_event/1.0",
  "title": "TIM Intelligence Manager Project Event",
  "type": "object",
  "required": ["event_id", "event_type", "entity_type", "entity_id", "occurred_at", "observed_at", "source_refs", "payload", "event_version"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["artifact_added", "artifact_changed", "artifact_deleted", "artifact_moved", "claim_superseded", "artifact_reclassified", "risk_resolved", "module_status_changed"]},
    "entity_type": {"type": "string"},
    "entity_id": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"},
    "event_version": {"type": "string"}
  },
  "additionalProperties": true
}
