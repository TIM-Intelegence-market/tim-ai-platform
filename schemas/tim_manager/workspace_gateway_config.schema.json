{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tim.local/schemas/tim_manager/workspace_gateway_config.schema.json",
  "title": "TIM Workspace Graphify Gateway Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "transport",
    "server_name",
    "authentication_mode",
    "allowed_clients",
    "allowed_operations",
    "read_only",
    "max_request_bytes",
    "max_query_length",
    "max_results",
    "max_response_bytes",
    "request_timeout_seconds",
    "max_parallel_requests",
    "rate_limit_requests",
    "rate_limit_window_seconds",
    "max_clock_skew_seconds",
    "replay_window_seconds",
    "audit_to_stderr",
    "allow_anonymous",
    "allow_unknown_operations",
    "allow_writes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "enabled": {"type": "boolean", "default": false},
    "transport": {"const": "stdio"},
    "server_name": {"const": "tim-workspace-graphify-readonly"},
    "authentication_mode": {"const": "secure_mcp_tunnel_required"},
    "allowed_clients": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "allowed_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "search_repository_graph",
          "get_graph_node",
          "get_node_neighbors",
          "get_graph_community",
          "get_graph_statistics",
          "get_shortest_path",
          "get_central_nodes",
          "health_check"
        ]
      }
    },
    "read_only": {"const": true},
    "max_request_bytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
    "max_query_length": {"type": "integer", "minimum": 1, "maximum": 8192},
    "max_results": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_response_bytes": {"type": "integer", "minimum": 4096, "maximum": 1048576},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "max_parallel_requests": {"type": "integer", "minimum": 1, "maximum": 4},
    "rate_limit_requests": {"type": "integer", "minimum": 1, "maximum": 1000},
    "rate_limit_window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_clock_skew_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "replay_window_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "audit_to_stderr": {"const": true},
    "allow_anonymous": {"const": false},
    "allow_unknown_operations": {"const": false},
    "allow_writes": {"const": false}
  }
}
