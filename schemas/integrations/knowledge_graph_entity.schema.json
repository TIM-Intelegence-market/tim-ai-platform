{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tim.local/schemas/integrations/knowledge_graph_entity.schema.json",
  "title": "TIM Knowledge Graph Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "entity_type",
    "version",
    "source",
    "source_hash",
    "observed_at",
    "index_mode",
    "relationships"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "module",
        "platform",
        "document",
        "commit",
        "branch",
        "test",
        "acceptance_report",
        "architecture_decision"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "index_mode": {
      "enum": [
        "full_content",
        "metadata_only"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "collector": {
          "type": "string"
        }
      }
    }
  }
}
