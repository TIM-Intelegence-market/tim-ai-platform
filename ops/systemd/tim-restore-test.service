# TIM weekly restore test of the newest backup
[Unit]
Description=TIM weekly restore test of the newest backup (OBSERVE only)
After=network-online.target postgresql.service

[Service]
Type=oneshot
ExecStart=/opt/tim/.venv/bin/python /opt/tim/scripts/tim_db_backup.py restore-test --dir /var/backups/tim
User=tim
Group=tim
WorkingDirectory=/opt/tim
EnvironmentFile=/etc/tim/tim.env
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/opt/tim/data /opt/tim/artifacts /var/backups/tim
