[Unit]
Description=TIM measured horizon inputs and bounded verified-gap reconciliation
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=tim
Group=tim
WorkingDirectory=/opt/tim
EnvironmentFile=/etc/tim/tim.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tim/.venv/bin/python /opt/tim/scripts/tim_readiness_inputs.py --resolve-verified --max-gaps 25 --max-trade-ids 200000
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/tim/data /opt/tim/artifacts
PrivateTmp=yes

