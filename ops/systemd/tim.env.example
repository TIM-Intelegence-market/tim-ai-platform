# Copy to /etc/tim/tim.env (root:tim, 0640). No secret values belong in this file:
# the database password lives only in TIM_DATABASE_SECRET_FILE (tim:tim, 0600).
TIM_DATABASE_SECRET_PROVIDER=file
TIM_DATABASE_SECRET_FILE=/etc/tim/database-password
TIM_ENABLE_OLLAMA=false
# TIM checkup: only `ops/debian/install_checkup.sh --configure` sets these lines; without them reporting is off.
# None of them is secret; the GitHub App key lives only in /etc/tim/github-app.pem (root:root, 0600).
# TIM_CHECKUP_REPORTING=off
# TIM_CHECKUP_DIAGNOSIS=off
# TIM_CHECKUP_APP_ID=
# TIM_CHECKUP_INSTALLATION_ID=
# TIM_CHECKUP_AUTHORITY_ISSUE=
# TIM_CHECKUP_WATCH_ISSUE=
# TIM_CHECKUP_REPORTER_LOGIN=<app-slug>[bot]
# TIM_CHECKUP_OWNER_LOGIN=uezeyiraydin-cell
