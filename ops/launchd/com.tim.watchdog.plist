<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/Documents/TIM/tim/.venv/bin/python</string>
    <string>/Users/tim/Documents/TIM/tim/scripts/tim_watchdog.py</string>
    <string>--interval</string><string>30</string>
    <string>--restart-after-red-cycles</string><string>3</string>
    <string>--restart-cooldown</string><string>300</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
    <key>TIM_DATABASE_SECRET_PROVIDER</key><string>file</string>
    <key>TIM_DATABASE_SECRET_FILE</key><string>/Users/tim/Library/Application Support/TIM/database-password</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/watchdog_launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/watchdog_launchd.err.log</string>
</dict>
</plist>
