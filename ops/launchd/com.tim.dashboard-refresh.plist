<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.dashboard-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/Documents/TIM/tim/.venv/bin/python</string>
    <string>/Users/tim/Documents/TIM/tim/scripts/dashboard_refresh.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
    <key>TIM_DATABASE_SECRET_PROVIDER</key><string>file</string>
    <key>TIM_DATABASE_SECRET_FILE</key><string>/Users/tim/Library/Application Support/TIM/database-password</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/dashboard_refresh_launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/dashboard_refresh_launchd.err.log</string>
</dict>
</plist>
