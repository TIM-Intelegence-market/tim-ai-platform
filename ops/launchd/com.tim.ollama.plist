<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tim.ollama</string>
  <key>UserName</key><string>tim-user</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/ollama</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/tim</string><key>OLLAMA_KEEP_ALIVE</key><string>-1</string></dict>
  <key>KeepAlive</key><true/><key>RunAtLoad</key><true/><key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/ollama_daemon.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/ollama_daemon.err.log</string>
</dict></plist>
