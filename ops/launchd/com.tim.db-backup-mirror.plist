<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.db-backup-mirror</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/Documents/TIM/tim/.venv/bin/python</string>
    <string>/Users/tim/Documents/TIM/tim/scripts/tim_db_backup.py</string>
    <string>mirror</string>
    <string>--dir</string>
    <string>/Users/tim/Library/Application Support/TIM/backups/live</string>
    <string>--target</string>
    <string>/Volumes/TIM-Backup/live</string>
    <string>--keep-count</string>
    <string>14</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>5</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/db_backup_mirror_launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/db_backup_mirror_launchd.err.log</string>
</dict>
</plist>
