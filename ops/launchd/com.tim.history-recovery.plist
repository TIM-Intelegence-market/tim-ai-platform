<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.history-recovery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/Documents/TIM/tim/.venv/bin/python</string>
    <string>/Users/tim/Documents/TIM/tim/scripts/tim_history_recovery.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
    <key>TIM_DATABASE_SECRET_PROVIDER</key><string>file</string>
    <key>TIM_DATABASE_SECRET_FILE</key><string>/Users/tim/Library/Application Support/TIM/database-password</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Standard</string>
  <!-- The full report is written to data/operational/history_recovery.json; stdout would only grow a log. -->
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim/data/operational/history_recovery_launchd.err.log</string>
</dict>
</plist>
