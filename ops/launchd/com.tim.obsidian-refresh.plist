<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.obsidian-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-m</string><string>src.obsidian_vault.auto_refresh</string>
    <string>--repo</string><string>/Users/tim/Documents/TIM/tim-graph</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim-graph</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
    <key>PATH</key><string>/opt/homebrew/bin:/Users/tim/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONPATH</key><string>/Users/tim/Documents/TIM/tim-graph</string>
    <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
    <key>TIM_OBSIDIAN_VAULT</key><string>/Users/tim/Documents/TIM/TIM OBSIDIAN</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/tim/Library/Application Support/TIM/obsidian-refresh/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Library/Application Support/TIM/obsidian-refresh/launchd.log</string>
</dict>
</plist>
