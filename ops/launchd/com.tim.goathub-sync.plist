<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tim.goathub-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tim/Documents/TIM/tim-broncx-feed/.venv/bin/python</string>
    <string>/Users/tim/Documents/TIM/tim-broncx-feed/scripts/goathub_discord_bot.py</string>
    <string>sync</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/tim/Documents/TIM/tim-broncx-feed</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/tim</string>
  </dict>
  <!-- Three times a day (local time): the whole channel is read up to the newest message and exported. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/tim/Documents/TIM/tim-broncx-feed/data/operational/goathub_sync.log</string>
  <key>StandardErrorPath</key><string>/Users/tim/Documents/TIM/tim-broncx-feed/data/operational/goathub_sync.err.log</string>
</dict>
</plist>
