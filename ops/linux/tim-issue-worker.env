# Arguments of tim-issue-worker.service (installed as /etc/tim-issue-worker.env, root only).
# Pilot: TIM_WORKER_ARGS=--pilot-issue 123   (one issue, opens the PR, no merge)
# Normal: --merge waits for GitHub's gate and merges; --self-update follows platform-main.
TIM_WORKER_ARGS=--merge --self-update
