# Arguments of tim-issue-worker.service (installed as /etc/tim-issue-worker.env, root only).
# --dry-run: only checks login and queue, writes nothing (the safe default after setup).
# --dry-run --self-update: same, and the checkout follows platform-main (Python packages are not reinstalled).
# Pilot:  TIM_WORKER_ARGS=--pilot-issue 123   (one issue, opens the PR, no merge)
# Normal: TIM_WORKER_ARGS=--merge --self-update   (waits for GitHub's gate and merges, follows platform-main)
TIM_WORKER_ARGS=--dry-run
# Ollama: 127.0.0.1:11434, or 127.0.0.2:11434 once the checkup drop-in (ops/systemd/ollama.service.d) is in place.
# setup_issue_worker.sh writes the address that answers.
TIM_QWEN_HARD_URL=http://127.0.0.1:11434
