{
  "name": "platform-main auto-merge",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/platform-main"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 0,
      "actor_type": "Integration",
      "bypass_mode": "always",
      "_comment": "Replace actor_id 0 with the App ID of the TIM Merger app. It must be the ONLY bypass actor. No repository role, no organization admin, no owner."
    }
  ],
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "update"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "test", "integration_id": 15368},
          {"context": "TIM full suite", "integration_id": 15368},
          {"context": "pr-gate/head", "integration_id": 15368}
        ]
      }
    }
  ]
}
